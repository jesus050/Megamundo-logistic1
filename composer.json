{
    "name": "megamundo/logistica",
    "description": "Sistema modular para gestión de bodega por lotes con flujo de aprobación, IA y tickets automáticos.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-only",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "MegaMundo\\Logistica\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MegaMundo\\Logistica\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "find src megamundo-logistica.php -name '*.php' -print0 | xargs -0 -n1 -P4 php -l"
    }
}
